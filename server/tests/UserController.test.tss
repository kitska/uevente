describe('UserController.createUser', () => {
  test('returns 400 if required fields missing', async () => {
    const res = await request(BASE_URL).post('/api/users').send({ email: 'a@mail.com' });
    expect(res.status).toBe(400);
  });

  test('returns 201 if user created', async () => {
    const res = await request(BASE_URL)
      .post('/api/users')
      .send({ fullName: 'A', email: 'a@mail.com', password: '123', login: 'user' });
    expect([201, 409]).toContain(res.status);
  });

  test('handles duplicate users gracefully', async () => {
    const res = await request(BASE_URL)
      .post('/api/users')
      .send({ fullName: 'A', email: 'a@mail.com', password: '123', login: 'user' });
    expect([201, 409]).toContain(res.status);
  });
});

