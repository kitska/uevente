import request from 'supertest';

const BASE_URL = 'http://localhost:8000'; // адрес запущенного сервера
const TEST_USER_ID = 'a76de4c3-bba0-4b3b-8bb9-7bf7c389ede4';
import { Event } from '../src/models/Event';
import { Comment } from '../src/models/Comment';


describe('AuthController.login', () => {
    test('returns post and comment count', async () => {
        const res = await request(BASE_URL).get('/api/users/1/stats');
        expect(res.body).toHaveProperty('postCount');
        expect(res.body).toHaveProperty('commentCount');
    });

    test('counts match manual queries', async () => {
        const [posts, comments] = await Promise.all([
            Event.find({ where: { id: TEST_USER_ID } }),
            Comment.find({ where: { id: TEST_USER_ID } })
        ]);
        const res = await request(BASE_URL).get('/api/users/1/stats');
        expect(res.body.postCount).toBe(posts.length);
        expect(res.body.commentCount).toBe(comments.length);
    });

    test('status 200', async () => {
        const res = await request(BASE_URL).get('/api/users/1/stats');
        expect(res.status).toBe(200);
    });
});
